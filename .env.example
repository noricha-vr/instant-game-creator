# 未設定ならモック生成で動きます。
CEREBRAS_API_KEY=

# serverless API で利用可能なモデルから選ぶ（/v1/models で確認可）。
# Kimi K2.6 は Dedicated Endpoints 専用のため serverless では使えない。
CEREBRAS_MODEL=zai-glm-4.7

# 1 にするとAPIキーがあってもモック生成にします。
CEREBRAS_MOCK=0

# 新しいHTMLアプリの保存先。未設定なら .local-data/apps.json です。
LOCAL_APPS_FILE=.local-data/apps.json

# 旧シミュレーション共有URLの読み取り専用保存先。
LOCAL_GAMES_FILE=.local-data/games.json
